# ==============================================================================
# Facebook Messenger Automation - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Django Core Settings
# ------------------------------------------------------------------------------
DJANGO_SECRET_KEY=replace-with-a-secure-random-secret-key
# Set to False in production to hide Django's detailed debug/traceback pages
DJANGO_DEBUG=True
ALLOWED_HOSTS=*
# Comma-separated trusted HTTPS origins for CSRF (e.g. when behind a reverse proxy or Cloudflare)
CSRF_TRUSTED_ORIGINS=https://message-automation.trunghsgs.edu.vn
DJANGO_HOST=0.0.0.0
DJANGO_PORT=8000

# Default timezone for scheduling (Default: Asia/Bangkok -> GMT+7)
TIME_ZONE=Asia/Bangkok

# ------------------------------------------------------------------------------
# Database Configuration
# Choices for DB_ENGINE: postgresql, mysql, sqlite (default)
# ------------------------------------------------------------------------------

# Option A: SQLite (Zero setup, default for local testing)
DB_ENGINE=sqlite
DB_NAME=db.sqlite3

# Option B: PostgreSQL (Recommended for production)
# DB_ENGINE=postgresql
# DB_NAME=messenger_automation
# DB_USER=postgres
# DB_PASSWORD=your_postgres_password
# DB_HOST=localhost
# DB_PORT=5432

# Option C: MySQL / MariaDB
# DB_ENGINE=mysql
# DB_NAME=messenger_automation
# DB_USER=root
# DB_PASSWORD=your_mysql_password
# DB_HOST=localhost
# DB_PORT=3306

# ------------------------------------------------------------------------------
# Redis & Celery Task Queue Settings
# ------------------------------------------------------------------------------
# Redis URL used for Django Channels WebSockets & Celery Task Broker
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
